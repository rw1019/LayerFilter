<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    ExtensionBundleId="com.wurao.photoshop.layerfilter"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Layer Filter"
    Version="6.0">
    <ExtensionList>
        <Extension Id="com.wurao.photoshop.layerfilter.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHXS" Version="[0.0,99.9]" />
            <Host Name="PHSP" Version="[0.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="6.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.wurao.photoshop.layerfilter.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>图层筛选</Menu>
                    <Geometry>
                        <Size>
                            <Height>520</Height>
                            <Width>330</Width>
                        </Size>
                        <MinSize>
                            <Height>430</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1000</Height>
                            <Width>700</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/IconLight.png</Icon>
                        <Icon Type="RollOver">./icons/IconLight.png</Icon>
                        <Icon Type="DarkNormal">./icons/IconDark.png</Icon>
                        <Icon Type="DarkRollOver">./icons/IconDark.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
